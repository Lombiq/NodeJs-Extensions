{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    'extends': ['github>Lombiq/renovate-config:default-dotnet.json5'],
     "packageRules": [
        {
            groupName: 'ESLint packages',
            matchPackageNames: [
                'eslint*',
            ],
        },
        {
            "groupName": "All packages",
            "matchUpdateTypes": ["*"],
        },
    ],
}
